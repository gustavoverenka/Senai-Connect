{
  "openapi": "3.0.0",
  "info": {
    "title": "API SENAI Connect",
    "description": "Documentação oficial da API do SENAI Connect. Esta API fornece os recursos necessários para autenticação, gerenciamento de perfis, publicações, conexões sociais e mensagens diretas.",
    "version": "1.0.0",
    "contact": {
      "name": "Equipe de Desenvolvimento SENAI Connect"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Servidor Local de Desenvolvimento"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Insira o token JWT gerado no login."
      }
    }
  },
  "tags": [
    { "name": "Health", "description": "Status do Servidor" },
    { "name": "Auth", "description": "Autenticação e Recuperação de Conta" },
    { "name": "Users", "description": "Gerenciamento de Perfis e Seguidores" },
    { "name": "Posts", "description": "Feed, Publicações, Curtidas e Comentários" },
    { "name": "Messages", "description": "Mensagens Diretas e Caixa de Entrada" }
  ],
  "paths": {
    "/api/status": {
      "get": {
        "tags": ["Health"],
        "summary": "Verifica o status da API",
        "responses": {
          "200": {
            "description": "API Online"
          }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "tags": ["Auth"],
        "summary": "Registra um novo usuário",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string", "example": "João Silva" },
                  "username": { "type": "string", "example": "joaosilva" },
                  "email": { "type": "string", "example": "joao@email.com" },
                  "password": { "type": "string", "example": "senhaSegura123" },
                  "role": { "type": "string", "enum": ["aluno", "ex-aluno", "professor", "admin"], "example": "aluno" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Usuário criado com sucesso" },
          "400": { "description": "Dados inválidos ou e-mail já existente" }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Realiza login na plataforma",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string", "example": "joao@email.com" },
                  "password": { "type": "string", "example": "senhaSegura123" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Login bem sucedido e token gerado" },
          "400": { "description": "Credenciais incorretas" },
          "401": { "description": "E-mail não verificado" }
        }
      }
    },
    "/api/auth/verify-email": {
      "post": {
        "tags": ["Auth"],
        "summary": "Verifica o e-mail do usuário via código de 6 dígitos",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string", "example": "joao@email.com" },
                  "code": { "type": "string", "example": "123456" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "E-mail verificado com sucesso" },
          "400": { "description": "Código inválido ou e-mail incorreto" }
        }
      }
    },
    "/api/auth/forgot-password": {
      "post": {
        "tags": ["Auth"],
        "summary": "Solicita recuperação de senha",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string", "example": "joao@email.com" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "E-mail de recuperação enviado (se o usuário existir)" }
        }
      }
    },
    "/api/auth/reset-password": {
      "post": {
        "tags": ["Auth"],
        "summary": "Redefine a senha utilizando o token recebido por e-mail",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "token": { "type": "string", "example": "token_recebido" },
                  "newPassword": { "type": "string", "example": "novaSenha321" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Senha redefinida com sucesso" },
          "400": { "description": "Token inválido ou expirado" }
        }
      }
    },
    "/api/users/me": {
      "get": {
        "tags": ["Users"],
        "summary": "Retorna os dados do perfil do usuário autenticado",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Dados do usuário retornados com sucesso" },
          "401": { "description": "Não autorizado" }
        }
      }
    },
    "/api/users/bio": {
      "put": {
        "tags": ["Users"],
        "summary": "Atualiza a biografia do perfil",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "bio": { "type": "string", "example": "Desenvolvedor Backend no SENAI" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Biografia atualizada" }
        }
      }
    },
    "/api/users/avatar": {
      "post": {
        "tags": ["Users"],
        "summary": "Faz o upload da foto de perfil",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "avatar": { "type": "string", "format": "binary" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Foto atualizada e salva no Storage" }
        }
      }
    },
    "/api/users/search": {
      "get": {
        "tags": ["Users"],
        "summary": "Busca usuários por nome ou nome de usuário",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": { "type": "string" },
            "description": "Termo de busca"
          }
        ],
        "responses": {
          "200": { "description": "Lista de usuários correspondentes" }
        }
      }
    },
    "/api/users/{id}/follow": {
      "post": {
        "tags": ["Users"],
        "summary": "Segue ou deixa de seguir um usuário (Toggle)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": { "description": "Ação executada com sucesso" }
        }
      }
    },
    "/api/users/{id}/followers": {
      "get": {
        "tags": ["Users"],
        "summary": "Lista os seguidores de um usuário específico",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": { "description": "Lista de seguidores retornada" }
        }
      }
    },
    "/api/users/{id}/following": {
      "get": {
        "tags": ["Users"],
        "summary": "Lista as pessoas que um usuário específico está seguindo",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": { "description": "Lista de usuários seguidos retornada" }
        }
      }
    },
    "/api/posts": {
      "get": {
        "tags": ["Posts"],
        "summary": "Retorna o feed de publicações global",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Feed retornado com sucesso" }
        }
      },
      "post": {
        "tags": ["Posts"],
        "summary": "Cria uma nova publicação",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "content": { "type": "string", "example": "Meu primeiro post no SENAI Connect!" },
                  "image": { "type": "string", "format": "binary", "description": "Imagem opcional" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Publicação criada com sucesso" }
        }
      }
    },
    "/api/posts/{id}/like": {
      "post": {
        "tags": ["Posts"],
        "summary": "Adiciona ou remove a curtida em uma publicação (Toggle)",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": { "description": "Ação de curtir/descurtir efetuada" }
        }
      }
    },
    "/api/posts/{id}/comments": {
      "post": {
        "tags": ["Posts"],
        "summary": "Adiciona um comentário em uma publicação",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "content": { "type": "string", "example": "Muito interessante o seu post!" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Comentário adicionado" }
        }
      }
    },
    "/api/posts/{id}": {
      "delete": {
        "tags": ["Posts"],
        "summary": "Exclui uma publicação (Requer permissão)",
        "description": "Apenas o autor da publicação ou um usuário com permissão de 'admin' podem excluí-la.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": { "description": "Publicação excluída com sucesso" },
          "403": { "description": "Permissão negada" },
          "404": { "description": "Publicação não encontrada" }
        }
      }
    },
    "/api/messages/inbox": {
      "get": {
        "tags": ["Messages"],
        "summary": "Retorna a caixa de entrada do usuário",
        "description": "Lista agrupada com a última mensagem trocada com cada contato, ordenado pela data mais recente.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Caixa de entrada retornada" }
        }
      }
    },
    "/api/messages/{id}": {
      "get": {
        "tags": ["Messages"],
        "summary": "Retorna o histórico de conversa com um usuário específico",
        "description": "Visualizar a conversa automaticamente marca as mensagens pendentes como lidas.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" },
            "description": "ID do usuário com quem se deseja visualizar a conversa"
          }
        ],
        "responses": {
          "200": { "description": "Histórico retornado com sucesso" }
        }
      },
      "post": {
        "tags": ["Messages"],
        "summary": "Envia uma mensagem direta para um usuário",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" },
            "description": "ID do destinatário"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "content": { "type": "string", "example": "Olá! Gostaria de tirar uma dúvida sobre o projeto." }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Mensagem enviada com sucesso" }
        }
      }
    }
  }
}
