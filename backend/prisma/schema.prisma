    datasource db {
      provider = "postgresql"
      url      = env("DATABASE_URL")
    }
    
    generator client {
      provider = "prisma-client-js"
    }
    
    //Modelo de Usuário
    model User {
      id              Int        @id @default(autoincrement())
      name            String
      username        String     @unique
      email           String     @unique
      password        String
      bio             String?    @default("")
      profilePicture  String?    @default("")
      createdAt       DateTime   @default(now())
    
      //Relacionamentos
      posts           Post[]
      comments        Comment[]
      likes           Like[]
      
      //Quem este usuário segue e quem segue este usuário
      following       Follow[]   @relation("UserFollowing")
      followers       Follow[]   @relation("UserFollowers")
    }
    
    //Modelo de Postagem
    model Post {
      id          Int        @id @default(autoincrement())
      content     String
      image       String?    @default("")
      createdAt   DateTime   @default(now())
      
      userId      Int
      author      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
    
      comments    Comment[]
      likes       Like[]
    }
    
    //Modelo de Curtida
    model Like {
      userId      Int
      postId      Int
      createdAt   DateTime   @default(now())
    
      user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
      post        Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
    
      @@id([userId, postId]) // Chave primária composta para impedir curtir 2 vezes
    }
    
    //Modelo de Comentário
    model Comment {
      id          Int        @id @default(autoincrement())
      content     String
      createdAt   DateTime   @default(now())
    
      userId      Int
      postId      Int
    
      author      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
      post        Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
    }
    
    //Modelo de Seguidores
    model Follow {
      followerId  Int
      followingId Int
      createdAt   DateTime   @default(now())
    
      follower    User       @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
      following   User       @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)
    
      @@id([followerId, followingId]) // Chave primária composta (impede seguir duas vezes)
    }
